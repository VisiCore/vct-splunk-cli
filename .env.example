# Splunk Enterprise REST API connection.
# Copy to `.env` (gitignored) and fill in. The token is never passed as a flag.

# Management / REST endpoint — port 8089, NOT the web UI on 8000.
SPLUNK_URL=https://your-search-head:8089

# A Splunk authentication (JWT) token: Settings -> Tokens, or
# POST /services/authorization/tokens. Sent as `Authorization: Bearer <token>`.
SPLUNK_TOKEN=

# Alternative to SPLUNK_TOKEN: a Splunk session key, sent as
# `Authorization: Splunk <key>`. Used only when SPLUNK_TOKEN is unset.
# SPLUNK_SESSION_KEY=

# --- Optional ----------------------------------------------------------------

# Verify TLS certificates (default: true). Set false only for a self-signed lab
# cert. An explicit SPLUNK_CA_BUNDLE always takes precedence over this.
# SPLUNK_VERIFY=true

# Path to a custom CA bundle (PEM) for on-prem / private CAs.
# SPLUNK_CA_BUNDLE=/path/to/ca.pem

# Where applied writes are appended (default:
# $XDG_STATE_HOME/vct-splunk/audit.log, else ~/.local/state/vct-splunk/audit.log).
# VCT_SPLUNK_AUDIT=/path/to/audit.log

# --- Namespace (owner + app) -------------------------------------------------

# Default app for namespaced resources (saved searches, knowledge objects, ...).
# Writes require an app and never fall back to "search"; set it here to avoid
# passing --app every time. Choose a real app you own, e.g. "my_app".
# SPLUNK_APP=

# Default owner for namespaced resources. Reads default to the "-" wildcard
# (all owners); writes default to "nobody" (an app-level shared object).
# SPLUNK_OWNER=

# --- Splunk Cloud (ACS) ------------------------------------------------------
# Read-only this release. Used by `splunk cloud ...` and `splunk inspect`.

# Your Splunk Cloud stack name (the <stack> in https://admin.splunk.com/<stack>).
# SPLUNK_ACS_STACK=

# An ACS authentication token (Bearer).
# SPLUNK_ACS_TOKEN=

# Which backend `splunk inspect` reports as active: enterprise (default) or cloud.
# SPLUNK_BACKEND=enterprise

# --- Session login + config profiles (#13) -----------------------------------
# Alternative to SPLUNK_TOKEN: a session key sent as `Authorization: Splunk <key>`.
# Mint one with `splunk auth login`. SPLUNK_TOKEN (Bearer) wins if both are set.
# SPLUNK_SESSION_KEY=

# For `splunk auth login`. The password is never a flag; it prompts if unset.
# SPLUNK_USERNAME=
# SPLUNK_PASSWORD=

# Config-file profiles: choose an INI [section] (precedence flag > env > profile).
# SPLUNK_PROFILE=
# Override the config path (else $XDG_CONFIG_HOME/vct-splunk/config, ~/.config/vct-splunk/config).
# VCT_SPLUNK_CONFIG=
