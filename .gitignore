# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl
*.tar.gz

# Virtual environments. No trailing slash: a pattern ending in `/` matches a
# directory only, so a `.venv` symlink -- the usual way to share one
# environment across git worktrees -- would slip past `git add -A`.
.venv
venv
ENV

# uv. This repo installs with stdlib `venv` + `pip`; a lock file from a local
# uv run is not part of the build and must not be committed.
uv.lock

# Git worktrees created beside this checkout
.worktrees/

# Environment files (keep the example)
.env
.env.*
!.env.example

# direnv
.direnv/

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checkers & linters
.ruff_cache/
.mypy_cache/
.pyright/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
