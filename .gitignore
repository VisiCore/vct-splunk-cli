# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl
*.tar.gz

# Virtual environments. `.venv` carries no trailing slash on purpose: a pattern
# ending in `/` matches a directory only, so a `.venv` symlink -- the usual way
# to share one environment across git worktrees -- would slip past `git add -A`.
# It is anchored so it cannot shadow a file of that name deeper in the tree.
/.venv
venv/
ENV/

# uv. This repo installs with stdlib `venv` + `pip`; a lock file from a local
# uv run is not part of the build and must not be committed.
uv.lock

# Git worktrees created beside this checkout
.worktrees/

# Environment files (keep the example)
.env
.env.*
!.env.example

# direnv. A machine-local `.envrc.local` is the conventional place for settings
# that must never leave one machine, so it is ignored here rather than left to
# each contributor to remember.
.direnv/
/.envrc.local

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checkers & linters
.ruff_cache/
.mypy_cache/
.pyright/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
